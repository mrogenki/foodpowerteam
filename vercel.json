
{
  "regions": ["hnd1"],
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/signup/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|TelegramBot|WhatsApp|Discordbot|LinkedInBot|Pinterest|Googlebot|bingbot|Applebot|SkypeUriPreview|Line/).*"
        }
      ],
      "destination": "/api/share?id=:id&signup=1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
