# 複製為專案根目錄的 .env.migration（已 gitignore，勿 commit）
# 兩個 DB 密碼：Supabase Dashboard → 各專案 → Settings → Database → Reset database password
OLD_DB_PASSWORD=
NEW_DB_PASSWORD=
# 新專案 service_role key：Dashboard → foodpowerteam-tokyo → Settings → API → service_role
NEW_SERVICE_ROLE_KEY=
# 舊專案 service_role key：Dashboard → foodpowerteam（孟買） → Settings → API → service_role
# （04-copy-secrets.sh 用來呼叫 migration-env-dump 匯出 secrets）
OLD_SERVICE_ROLE_KEY=
# Supabase 個人存取權杖（取代 supabase login）：
# https://supabase.com/dashboard/account/tokens → Generate new token（名稱隨意，例如 migration）
SUPABASE_ACCESS_TOKEN=
